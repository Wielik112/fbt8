# --- FBT Outlet admin panel ---

# Password required to sign in to /admin. Set this in the Vercel
# project (Settings -> Environment Variables). Choose something strong.
ADMIN_PASSWORD=change-me

# Optional. Secret used to sign the admin session cookie. If omitted,
# ADMIN_PASSWORD is used to derive the signing key. Set a long random
# value in production so rotating the password does not silently reuse it.
SESSION_SECRET=

# --- Database (Vercel Postgres / Neon) ---
# These are injected automatically when you attach a Vercel Postgres
# store to the project. You do NOT need to set them by hand on Vercel.
# For local `vercel dev`, pull them with: vercel env pull .env.local
# POSTGRES_URL=
# DATABASE_URL=

# --- Payments (Stripe) ---
# Secret API key (Dashboard -> Developers -> API keys). Use the test key
# (sk_test_...) until you go live, then the live key (sk_live_...).
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...). Create an endpoint pointing at
# https://<your-domain>/api/stripe-webhook subscribed to:
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   checkout.session.async_payment_failed, checkout.session.expired,
#   charge.refunded
# then copy its signing secret here.
STRIPE_WEBHOOK_SECRET=

# Optional. Comma-separated Checkout payment methods (must also be enabled
# in the Stripe Dashboard). Defaults to card,blik,p24.
# STRIPE_PAYMENT_METHODS=card,blik,p24

# Optional. Absolute site URL used to build Stripe success/cancel links.
# If unset it is derived from the incoming request headers, which is fine
# on Vercel. Set it only if you need to force a specific canonical domain.
# PUBLIC_BASE_URL=https://your-domain.com

# --- Furgonetka.pl (server-side: parcels + labels for ALL carriers) ---
# One integration for InPost, DPD, Pocztex and Orlen Paczka. Create an
# OAuth application in Furgonetka (Moje konto -> Integracje -> API REST /
# "Aplikacje OAuth") to get the client id + secret, then give the login of
# the Furgonetka account that pays for the parcels (2FA must be OFF for it).
FURGONETKA_CLIENT_ID=
FURGONETKA_CLIENT_SECRET=
FURGONETKA_USERNAME=
FURGONETKA_PASSWORD=
# 'sandbox' (https://sandbox.furgonetka.pl, separate account) while testing,
# 'production' when live. Defaults to production.
FURGONETKA_ENV=sandbox

# Sender / pickup address printed on every label (required).
FURGONETKA_SENDER_NAME=FBT Outlet
FURGONETKA_SENDER_COMPANY=
FURGONETKA_SENDER_STREET=Lubieszów 87
FURGONETKA_SENDER_POSTCODE=67-100
FURGONETKA_SENDER_CITY=
FURGONETKA_SENDER_PHONE=
FURGONETKA_SENDER_EMAIL=kontakt@fbtoutlet.pl

# Optional. 1 (default) = order the label automatically right after payment;
# 0 = only create a draft, you click "Zamów przesyłkę" in /admin.
# FURGONETKA_AUTO_ORDER=1

# Optional. Pin exact Furgonetka service ids per shipping method when the
# automatic match (by carrier) picks the wrong one. Ids are listed in
# /admin -> Zamówienia -> "Konfiguracja wysyłek".
# FURGONETKA_SERVICE_IDS={"inpost_locker":123,"dpd_courier":456}

# --- InPost ShipX (optional fallback, InPost methods only) ---
# Used only when Furgonetka is NOT configured.
# Business InPost / ShipX account. Create an API token in the InPost
# manager (Zarządzaj → API / ShipX) and copy your organization id.
# Used to create shipments and print labels from the admin panel.
INPOST_SHIPX_TOKEN=
INPOST_ORG_ID=
# 'sandbox' while testing, 'production' when live. Defaults to production.
INPOST_ENV=sandbox

# --- InPost Geowidget (front-end) ---
# The Geowidget token is a PUBLIC, client-side value and lives in
# js/config.js (inpostGeowidgetToken), NOT here. Leave it empty to fall
# back to manual Paczkomat code entry.
